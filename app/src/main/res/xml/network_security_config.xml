<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config>
        <!--
          H-05: multi-SPKI pins, per-host, from the LIVE certificate chain.
          First pin = local (CN) edge leaf; second pin = US/Azure edge leaf observed
          on CI runners (2026-08-31). GitHub/CDN serve different LEAF certs per
          region, so the pin-set must accept any observed leaf; Android
          <pin-set> passes if ANY pin matches ANY cert in the presented chain.
          Last two pins = documented GitHub public pins retained as rotation backups.
        -->
        <domain includeSubdomains="true">raw.githubusercontent.com</domain>
        <pin-set expiration="2030-01-01">
            <pin digest="SHA-256">u5HUV+53eJaqAZQekPBc2vbRb9LvpJzlK8dhGLIPF+o=</pin>
            <pin digest="SHA-256">p4MbBTfU3MTzqPxM2Cjv0q3WON8L6FqSzam65NVEkcM=</pin>
            <pin digest="SHA-256">k2v657xBsOVe1PQRwWoDp9Fxfi2I4l4GlRnNfCeIDrI=</pin>
            <pin digest="SHA-256">RRM1dGqnDFsCJXBTHky16vi1obOlCgFFn/yOhI/y+ho=</pin>
        </pin-set>
    </domain-config>

    <domain-config>
        <domain includeSubdomains="true">api.github.com</domain>
        <pin-set expiration="2030-01-01">
            <pin digest="SHA-256">cgAMm7z20VINmtPjImmTrEl882gSBr0fIhdLTtHveyY=</pin>
            <pin digest="SHA-256">S2LUIbq4yUg5w+MYbj5LZOWAZAzaeNGJ9rTTc4GjvBQ=</pin>
            <pin digest="SHA-256">k2v657xBsOVe1PQRwWoDp9Fxfi2I4l4GlRnNfCeIDrI=</pin>
            <pin digest="SHA-256">RRM1dGqnDFsCJXBTHky16vi1obOlCgFFn/yOhI/y+ho=</pin>
        </pin-set>
    </domain-config>
</network-security-config>
